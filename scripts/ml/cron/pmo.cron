# PMO PMS - AI 预警 自动化任务
# m h dom mon dow command
#
# 安装:   crontab scripts/ml/cron/pmo.cron
# 卸载:   crontab -l | grep -v "PMO PMS" | crontab -
# 查看:   crontab -l

# 环境变量 (cron 不会自动加载 PATH, 必须显式设置)
SHELL=/bin/zsh
PATH=/opt/homebrew/opt/python@3.12/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
PMO_HOME=/Users/lzg/Documents/pmo-pms

# ---------------------------------------------------------------
# 1) 每日 02:00 - outcome 反馈循环
#    扫 7+ 天前 advisory, 算出真实 outcome_severity
#    UPSERT → milestone_ai_outcome (供下次训练用)
# ---------------------------------------------------------------
0 2 * * *  cd $PMO_HOME && /opt/homebrew/opt/python@3.12/bin/python3.12 scripts/ml/outcome_recompute.py --min-age-days 7 >> logs/outcome_recompute.log 2>&1

# ---------------------------------------------------------------
# 2) 每周一 03:00 - 增量训练
#    新 outcome → 新 pkl (按日期命名, 保留 7 天历史)
#    accuracy 监控: 训练脚本自动打印 classification_report
# ---------------------------------------------------------------
0 3 * * 1  cd $PMO_HOME && /opt/homebrew/opt/python@3.12/bin/python3.12 scripts/ml/milestone_lgbm.py train --output models/milestone_lgbm_$(date +\%Y\%m\%d).pkl >> logs/train_$(date +\%Y\%m\%d).log 2>&1

# ---------------------------------------------------------------
# 3) 每周一 03:30 - 模型切换 (灰度)
#    重启 ml_service 加载最新 pkl
#    Spring Boot 端无需重启 (MlPredictorImpl 走 HTTP)
# ---------------------------------------------------------------
30 3 * * 1  cd $PMO_HOME && /usr/bin/pkill -f "ml_service.py" 2>/dev/null; sleep 2; /opt/homebrew/opt/python@3.12/bin/python3.12 scripts/ml/ml_service.py --model models/milestone_lgbm_$(date +\%Y\%m\%d).pkl --port 8000 > logs/ml_service.log 2>&1 &

# ---------------------------------------------------------------
# 4) 每周日 23:00 - 日志清理
#    删除 30+ 天前日志, 防止磁盘占满
# ---------------------------------------------------------------
0 23 * * 0  cd $PMO_HOME && /usr/bin/find logs -name "*.log" -mtime +30 -delete && /usr/bin/find logs -name "*.log" -mtime +30 -delete

# ---------------------------------------------------------------
# 5) 每 5 分钟 - 健康检查 + 自动重启
#    ml_service 挂了 → 自动拉起 (用最近一次 pkl)
# ---------------------------------------------------------------
*/5 * * * *  cd $PMO_HOME && /usr/bin/curl -sf http://localhost:8000/health > /dev/null || (/usr/bin/pkill -f "ml_service.py" 2>/dev/null; sleep 2; /opt/homebrew/opt/python@3.12/bin/python3.12 scripts/ml/ml_service.py --model models/milestone_lgbm_real.pkl --port 8000 >> logs/ml_service.log 2>&1 &)

# ---------------------------------------------------------------
# 6) 每天 23:55 - 备份 outcome 表 (近 7 天) → CSV
#    留 audit trail, 万一数据被误删可恢复
# ---------------------------------------------------------------
55 23 * * *  cd $PMO_HOME && /opt/homebrew/opt/python@3.12/bin/python3.12 scripts/ml/outcome_backup.py --days 7 --output backups/outcome_$(date +\%Y\%m\%d).csv >> logs/outcome_backup.log 2>&1
